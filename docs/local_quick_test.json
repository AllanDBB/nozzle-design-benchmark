{
  "_comment": "Local test config — no Docker or OpenFOAM required. Uses the quasi-1D CFD evaluator. Runs in ~5 seconds.",
  "_usage": "python main_pipeline.py --config docs/local_quick_test.json",
  "out_dir": "out/local_quick_test",
  "moc": {
    "mach_exit": 2.4,
    "pressure_ratio": 0.09,
    "gamma": 1.4,
    "geometry": {
      "throat_y": 0.02,
      "exit_y": 0.062,
      "length": 0.22,
      "n_points": 120
    }
  },
  "evaluator": {
    "backend": "quasi1d",
    "campaign": "design_supersonic",
    "require_rans_converged": false,
    "require_converged_series": false,
    "gamma": 1.4,
    "stagnation_temperature": 1000.0,
    "stagnation_pressure": 600000.0,
    "ambient_pressure": 80000.0,
    "n_samples": 60,
    "friction_scale": 0.2,
    "cf_multiplier": 1.0,
    "curvature_scale": 0.05,
    "bl_displacement_scale": 1.0,
    "discharge_coefficient": 0.985,
    "enable_shock_model": true,
    "shock_trigger_ratio": 0.55,
    "divergence_scale": 1.0,
    "fallback_on_failure": false,
    "use_gpu": false
  },
  "optimization": {
    "strategy": "single_fidelity",
    "algorithm": "evolutionary",
    "seed": 42,
    "bounds": {
      "exit_radius": [0.050, 0.075],
      "length": [0.18, 0.28],
      "theta_max": [10.0, 38.0],
      "inflection_frac": [0.15, 0.55],
      "throat_angle": [1.0, 10.0]
    },
    "population": 12,
    "generations": 6,
    "sigma": 0.15,
    "sigma_decay": 0.88,
    "n_points": 120,
    "profile": "rao",
    "seed_moc": true,
    "w_thrust": 1.0,
    "w_pressure_loss": 0.3,
    "use_pareto_knee": true,
    "n_workers": 1
  }
}
