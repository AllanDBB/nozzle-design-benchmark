{
  "_comment": "Ensemble CI (4 algorithms) with RANS validation of Pareto front. ~20-40 min in Docker.",
  "out_dir": "out/ensemble_rans",
  "evaluator": {
    "backend": "openfoam",
    "campaign": "design_supersonic",
    "dimension": "2d_planar",
    "depth": 0.02,
    "gamma": 1.4,
    "gas_constant": 287.0,
    "stagnation_temperature": 900.0,
    "stagnation_pressure": 300000.0,
    "ambient_pressure": 24000.0,
    "n_samples": 90,
    "mesh_nx": 100,
    "mesh_ny": 45,
    "end_time": 0.004,
    "write_interval": 0.0004,
    "max_co": 0.3,
    "delta_t_init": 1e-7,
    "enable_delta_t_abort": true,
    "delta_t_abort_threshold": 1e-80,
    "delta_t_abort_streak": 20,
    "inlet_velocity": 20.0,
    "k_inlet": 1.0,
    "epsilon_inlet": 50.0,
    "p_initial": 270000.0,
    "u_initial": 1.0,
    "t_initial": 900.0,
    "outlet_bc_mode": "wave_transmissive",
    "sampling_nx": 81,
    "fallback_on_failure": true,
    "convergence_window": 5,
    "convergence_tol": {
      "p_out_rel_std": 0.02,
      "mdot_rel_std": 0.02,
      "ux_out_rel_std": 0.03
    },
    "min_writes": 8,
    "require_converged_series": true,
    "friction_scale": 0.2,
    "cf_multiplier": 1.0,
    "curvature_scale": 0.05,
    "bl_displacement_scale": 1.0,
    "discharge_coefficient": 0.985,
    "enable_shock_model": true,
    "shock_trigger_ratio": 0.55,
    "divergence_scale": 1.0,
    "use_gpu": false
  },
  "optimization": {
    "algorithms": ["pso", "mopso_lf", "firefly", "abc"],
    "swarm_size": 10,
    "iterations": 5,
    "n_points": 180,
    "profile": "mln",
    "seed": 42,
    "bounds": {
      "exit_radius": [0.050, 0.070],
      "length": [0.18, 0.28],
      "straighten_frac": [0.30, 0.70],
      "ramp_power": [0.40, 1.20],
      "throat_angle_deg": [1.0, 8.0]
    },
    "w_thrust": 0.7,
    "w_pressure_loss": 0.3,
    "n_workers": 1,
    "rans_top_k": 4,
    "colony_size": 20,
    "limit": 0,
    "onlooker_ratio": 1.0,
    "archive_size": 50,
    "n_char_lines": 80
  }
}
